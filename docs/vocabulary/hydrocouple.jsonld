        "@id": "https://hydrocouple.org/HydroCouple/vocabulary/"
      }
    },
    {
      "@id": "hc:ICheckpointableModelComponent",
      "@type": "owl:Class",
      "rdfs:label": "ICheckpointableModelComponent",
      "rdfs:comment": {
        "@value": "ICheckpointableModelComponent is an IModelComponent that can save and restore its complete simulation state.",
        "@language": "en"
      },
      "rdfs:subClassOf": {
        "@id": "hc:IModelComponent"
      },
      "hc:cppName": "HydroCouple::ICheckpointableModelComponent",
