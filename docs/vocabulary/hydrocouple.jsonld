    {
      "@id": "hc:ComponentStatus",
      "@type": [
        "owl:Class",
        "skos:ConceptScheme"
      ],
      "rdfs:label": "ComponentStatus",
      "rdfs:comment": {
        "@value": "HydroCouple::ComponentStatus is an enumerator that describes the status of a component over the course of its lifetime.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus",
      "rdfs:isDefinedBy": {
        "@id": "https://hydrocouple.org/HydroCouple/vocabulary/"
      },
      "skos:hasTopConcept": [
        {
          "@id": "hc:ComponentStatus.Created"
        },
        {
          "@id": "hc:ComponentStatus.Initializing"
        },
        {
          "@id": "hc:ComponentStatus.Initialized"
        },
        {
          "@id": "hc:ComponentStatus.Validating"
        },
        {
          "@id": "hc:ComponentStatus.Valid"
        },
        {
          "@id": "hc:ComponentStatus.WaitingForData"
        },
        {
          "@id": "hc:ComponentStatus.Invalid"
        },
        {
          "@id": "hc:ComponentStatus.Preparing"
        },
        {
          "@id": "hc:ComponentStatus.Updating"
        },
        {
          "@id": "hc:ComponentStatus.Updated"
        },
        {
          "@id": "hc:ComponentStatus.Checkpointing"
        },
        {
          "@id": "hc:ComponentStatus.Done"
        },
        {
          "@id": "hc:ComponentStatus.Finishing"
        },
        {
          "@id": "hc:ComponentStatus.Finished"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Created",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Created",
      "skos:notation": {
        "@value": "0",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent instance has just been created. This status must and will be followed by HydroCouple::Initializing.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Created",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Initializing"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Initializing",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Initializing",
      "skos:notation": {
        "@value": "1",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent is initializing itself. This status will end in a status change to HydroCouple::Initialized or HydroCouple::Failed.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Initializing",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Initialized"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Initialized",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Initialized",
      "skos:notation": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent has successfully initialized itself by calling IModelComponent::initialize(). The connections between its inputs/outputs and those of other components can be established.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Initialized",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Initializing"
        },
        {
          "@id": "hc:ComponentStatus.Validating"
        },
        {
          "@id": "hc:ComponentStatus.Finishing"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Validating",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Validating",
      "skos:notation": {
        "@value": "3",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "After links between an IModelComponent's inputs/outputs and those of other components have been established, the IModelComponent is HydroCouple::Validating whether its required input will be available when it updates itself, and whether indeed it will be able to provide the required output during this update. This Validating status will when the IModelComponent::status() changes to HydroCouple::Valid or HydroCouple::Invalid.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Validating",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Valid"
        },
        {
          "@id": "hc:ComponentStatus.Invalid"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Valid",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Valid",
      "skos:notation": {
        "@value": "4",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent is in a HydroCouple::Valid state. When updating itself its required input will be available, and it will be able to provide the required output.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Valid",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Validating"
        },
        {
          "@id": "hc:ComponentStatus.Preparing"
        },
        {
          "@id": "hc:ComponentStatus.Finishing"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.WaitingForData",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "WaitingForData",
      "skos:notation": {
        "@value": "5",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent wants to update itself, but is not yet able to perform the actual computation, because it is still waiting for input data from other components.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::WaitingForData",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Updating"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Invalid",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Invalid",
      "skos:notation": {
        "@value": "6",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent is in an HydroCouple::Invalid state. When updating itself not all required input will be available, and/or it will not be able to provide the required output. After the user has modified the connections between the IModelComponent's inputs/outputs and those of other components, the HydroCouple::Validating state can be entered again",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Invalid",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Validating"
        },
        {
          "@id": "hc:ComponentStatus.Finishing"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Preparing",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Preparing",
      "skos:notation": {
        "@value": "7",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent is preparing itself for the first update() and the first IComponentDataItem::getValuesInto() call. This HydroCouple::Preparing state will end in a status change to HydroCouple::Updated or HydroCouple::Failed.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Preparing",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Updated"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Updating",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Updating",
      "skos:notation": {
        "@value": "8",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent is updating itself. It has received all required input data from other components, and is now performing the actual computation. This HydroCouple::Updating state will end in a status change to HydroCouple::Updated, HydroCouple::Done or HydroCouple::Failed.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Updating",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.WaitingForData"
        },
        {
          "@id": "hc:ComponentStatus.Updated"
        },
        {
          "@id": "hc:ComponentStatus.Done"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Updated",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Updated",
      "skos:notation": {
        "@value": "9",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent has successfully updated itself.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Updated",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Updating"
        },
        {
          "@id": "hc:ComponentStatus.Checkpointing"
        },
        {
          "@id": "hc:ComponentStatus.Finishing"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Checkpointing",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Checkpointing",
      "skos:notation": {
        "@value": "10",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent is saving or restoring a checkpoint of its state (see ICheckpointableModelComponent). A save returns to the status it was entered from (HydroCouple::Updated or HydroCouple::Done); a successful restore always lands in HydroCouple::Updated; a failure lands in HydroCouple::Failed.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Checkpointing",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Updated"
        },
        {
          "@id": "hc:ComponentStatus.Done"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Done",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Done",
      "skos:notation": {
        "@value": "11",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The last update process that the IModelComponent performed was the final one. A next call to the IModelComponent::update() method will leave the IModelComponent's internal state unchanged.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Done",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Checkpointing"
        },
        {
          "@id": "hc:ComponentStatus.Finishing"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Finishing",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Finishing",
      "skos:notation": {
        "@value": "12",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent was requested to perform the actions to be performed before it will either be disposed or re-initialized again.Typical actions would be writing the final result files, close all open files, free memory, etc. When all required actions have been performed, the status switches to HydroCouple::Created when re-initialization is possible. The status switches to HydroCouple::Finished when the IModelComponent is to be disposed",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Finishing",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Created"
        },
        {
          "@id": "hc:ComponentStatus.Finished"
        },
        {
          "@id": "hc:ComponentStatus.Failed"
        }
      ]
    },
    {
      "@id": "hc:ComponentStatus.Finished",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Finished",
      "skos:notation": {
        "@value": "13",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent has successfully performed its finalization actions. Re-initialization of the IModelComponent instance is not possible and should not be attempted. Instead the instance should be destroyed by its owner, after its connections are dismantled (see the lifetime convention).",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Finished"
    },
    {
      "@id": "hc:ComponentStatus.Failed",
      "@type": [
        "skos:Concept",
        "hc:ComponentStatus"
      ],
      "skos:inScheme": {
        "@id": "hc:ComponentStatus"
      },
      "skos:topConceptOf": {
        "@id": "hc:ComponentStatus"
      },
      "skos:prefLabel": "Failed",
      "skos:notation": {
        "@value": "14",
        "@type": "xsd:integer"
      },
      "skos:definition": {
        "@value": "The IModelComponent has encountered an unrecoverable error. Reachable from every status except Finished: a failure can be detected while the component rests (a proxy whose peer dies while it is Updated). Diagnostics describing the failure must be available from IModelComponent::errors(). From this state the component may be re-initialized by calling initialize() if it supports re-initialization, or finished and disposed via finish().",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::IModelComponent::ComponentStatus::Failed",
      "hc:mayTransitionTo": [
        {
          "@id": "hc:ComponentStatus.Initializing"
        },
        {
          "@id": "hc:ComponentStatus.Finishing"
        }
      ]
    },
