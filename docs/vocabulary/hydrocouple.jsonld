      }
    },
    {
      "@id": "hc:ICheckpointableAdaptedOutput",
      "@type": "owl:Class",
      "rdfs:label": "ICheckpointableAdaptedOutput",
      "rdfs:comment": {
        "@value": "ICheckpointableAdaptedOutput is an adapted output that can save and restore the state it carries between refreshes.",
        "@language": "en"
      },
      "rdfs:subClassOf": {
        "@id": "hc:IAdaptedOutput"
      },
      "hc:cppName": "HydroCouple::ICheckpointableAdaptedOutput",
