      "rdfs:subClassOf": {
        "@id": "hc:IComponentDataItem"
      },
      "hc:canonicalDimensionOrdering": {
        "@value": "the geometry dimension is dimension 0 of shape() (IDimension::DimensionRole::Entity); any additional dimensions follow.",
