  "@graph": [
    {
      "@id": "https://hydrocouple.org/HydroCouple/vocabulary/",
      "@type": "owl:Ontology",
      "dcterms:title": {
        "@value": "HydroCouple interface vocabulary",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "The concepts of the HydroCouple component interface standard — its interfaces, enumerations, accessors and lifecycle state machines — generated from the C++ headers, which remain the normative definition.",
        "@language": "en"
      },
      "owl:versionInfo": "2.0.0-beta.1 (interface ABI 5)",
      "dcterms:license": {
        "@id": "https://opensource.org/licenses/MIT"
      },
      "rdfs:seeAlso": {
        "@id": "https://github.com/HydroCouple/HydroCouple"
      }
    },
    {
      "@id": "hc:cppName",
      "@type": "owl:AnnotationProperty",
      "rdfs:label": "cppName",
      "rdfs:comment": {
        "@value": "The fully qualified C++ name the term is generated from.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://hydrocouple.org/HydroCouple/vocabulary/"
      }
    },
    {
      "@id": "hc:canonicalDimensionOrdering",
      "@type": "owl:AnnotationProperty",
      "rdfs:label": "canonicalDimensionOrdering",
      "rdfs:comment": {
        "@value": "The order of a data item's axes, as its C++ documentation states it.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://hydrocouple.org/HydroCouple/vocabulary/"
      }
    },
    {
      "@id": "hc:mayTransitionTo",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "mayTransitionTo",
      "rdfs:comment": {
        "@value": "A legal lifecycle transition (normative: Helpers::isValidComponentStatusTransition() and isValidWorkflowStatusTransition()).",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://hydrocouple.org/HydroCouple/vocabulary/"
      }
    },
    {
      "@id": "hc:BufferDescriptor",
      "@type": "owl:Class",
      "rdfs:label": "BufferDescriptor",
      "rdfs:comment": {
        "@value": "BufferDescriptor describes a typed, possibly strided, possibly device-resident multi-dimensional array. It is the sole currency of field data exchange.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::BufferDescriptor",
      "rdfs:isDefinedBy": {
        "@id": "https://hydrocouple.org/HydroCouple/vocabulary/"
      }
    },
    {
      "@id": "hc:DifferentialEntry",
      "@type": "owl:Class",
      "rdfs:label": "DifferentialEntry",
      "rdfs:comment": {
        "@value": "DifferentialEntry pairs one data item, in one role, with a buffer holding its tangent (forward mode) or cotangent (reverse mode).",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::DifferentialEntry",
      "rdfs:isDefinedBy": {
        "@id": "https://hydrocouple.org/HydroCouple/vocabulary/"
      }
    },
    {
      "@id": "hc:Endpoint",
      "@type": "owl:Class",
      "rdfs:label": "Endpoint",
      "rdfs:comment": {
        "@value": "Endpoint identifies one participant reachable through this transport.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::Distributed::ITransport::Endpoint",
      "rdfs:isDefinedBy": {
        "@id": "https://hydrocouple.org/HydroCouple/vocabulary/"
      }
    },
    {
      "@id": "hc:ErrorEntry",
      "@type": "owl:Class",
      "rdfs:label": "ErrorEntry",
      "rdfs:comment": {
