    {
      "@id": "hc:IArgument",
      "@type": "owl:Class",
      "rdfs:label": "IArgument",
      "rdfs:comment": {
        "@value": "IArgument interface class used to set the arguments for components. They can be complex or simple multi-dimensional datasets",
        "@language": "en"
      },
      "rdfs:subClassOf": {
        "@id": "hc:IComponentDataItem"
      },
      "hc:cppName": "HydroCouple::IArgument",
