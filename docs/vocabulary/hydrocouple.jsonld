    {
      "@id": "hc:IEdge",
      "@type": "owl:Class",
      "rdfs:label": "IEdge",
      "rdfs:comment": {
        "@value": "A directed edge from one vertex to another, adjacent to two faces. Based on Dani Lischinski's code from Graphics Gems IV. Original quad-edge data structure due to Guibas and Stolfi (1985). Does not inherit from geometry to reduce size. since each edge has 4 pointers.",
        "@language": "en"
      },
      "hc:cppName": "HydroCouple::Spatial::IEdge",
      "rdfs:isDefinedBy": {
        "@id": "https://hydrocouple.org/HydroCouple/vocabulary/"
      }
    },
    {
      "@id": "hc:IEnvelope",
      "@type": "owl:Class",
      "rdfs:label": "IEnvelope",
      "rdfs:comment": {
