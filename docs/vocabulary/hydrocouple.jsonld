    {
      "@id": "hc:ICurve",
      "@type": "owl:Class",
      "rdfs:label": "ICurve",
      "rdfs:comment": {
        "@value": "A Curve is a 1-dimensional geometric object usually stored as a sequence of IPoints, with the subtype of ICurve specifying the form of the interpolation between IPoints.",
