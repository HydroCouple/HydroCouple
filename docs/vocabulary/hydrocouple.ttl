hc:VerticalCoordinateKind.Unknown
    a skos:Concept, hc:VerticalCoordinateKind ;
    skos:inScheme hc:VerticalCoordinateKind ;
    skos:topConceptOf hc:VerticalCoordinateKind ;
    skos:prefLabel "Unknown" ;
    skos:notation "0"^^xsd:integer ;
    skos:definition "Not declared. Consumers must not assume."@en ;
    hc:cppName "HydroCouple::Spatial::VerticalCoordinateKind::Unknown" .

hc:VerticalCoordinateKind.Sigma
    a skos:Concept, hc:VerticalCoordinateKind ;
