    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> ;
    skos:hasTopConcept hc:WorkflowStatus.Created, hc:WorkflowStatus.Initializing, hc:WorkflowStatus.Initialized, hc:WorkflowStatus.Validating, hc:WorkflowStatus.Validated, hc:WorkflowStatus.Preparing, hc:WorkflowStatus.Prepared, hc:WorkflowStatus.Updating, hc:WorkflowStatus.Updated, hc:WorkflowStatus.Paused, hc:WorkflowStatus.Done, hc:WorkflowStatus.Finishing, hc:WorkflowStatus.Finished, hc:WorkflowStatus.Failed, hc:WorkflowStatus.Invalid .

