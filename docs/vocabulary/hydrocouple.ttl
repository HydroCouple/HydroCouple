    skos:inScheme hc:ValueKind ;
    skos:topConceptOf hc:ValueKind ;
    skos:prefLabel "Flux" ;
    skos:notation "3"^^xsd:integer ;
    skos:definition "Per unit area and time. Integrates over the area it crosses."@en ;
    hc:cppName "HydroCouple::ValueKind::Flux" .

hc:ValueKind.Density
    a skos:Concept, hc:ValueKind ;
    skos:inScheme hc:ValueKind ;
    skos:topConceptOf hc:ValueKind ;
    skos:prefLabel "Density" ;
    skos:notation "4"^^xsd:integer ;
