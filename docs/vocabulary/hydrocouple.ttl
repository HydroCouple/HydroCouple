hc:WorkflowStatus.Initializing
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Initializing" ;
    skos:notation "1"^^xsd:integer ;
    skos:definition "The workflow component is initializing itself."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Initializing" ;
    hc:mayTransitionTo hc:WorkflowStatus.Initialized, hc:WorkflowStatus.Failed .

hc:WorkflowStatus.Initialized
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Initialized" ;
    skos:notation "2"^^xsd:integer ;
    skos:definition "The workflow component has successfully initialized."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Initialized" ;
    hc:mayTransitionTo hc:WorkflowStatus.Initializing, hc:WorkflowStatus.Validating, hc:WorkflowStatus.Finishing, hc:WorkflowStatus.Failed .

hc:WorkflowStatus.Validating
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Validating" ;
    skos:notation "3"^^xsd:integer ;
    skos:definition "The workflow component is validating the composition (cross-component links, required roles)."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Validating" ;
    hc:mayTransitionTo hc:WorkflowStatus.Validated, hc:WorkflowStatus.Failed, hc:WorkflowStatus.Invalid .

hc:WorkflowStatus.Validated
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Validated" ;
    skos:notation "4"^^xsd:integer ;
    skos:definition "The workflow component found the composition valid and ready to prepare."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Validated" ;
    hc:mayTransitionTo hc:WorkflowStatus.Validating, hc:WorkflowStatus.Preparing, hc:WorkflowStatus.Finishing, hc:WorkflowStatus.Failed .

hc:WorkflowStatus.Preparing
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Preparing" ;
    skos:notation "5"^^xsd:integer ;
    skos:definition "The workflow component is preparing the composition for computation (e.g., driving IModelComponent::prepare(), building execution schedules, negotiating exchange patterns)."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Preparing" ;
    hc:mayTransitionTo hc:WorkflowStatus.Prepared, hc:WorkflowStatus.Failed .

hc:WorkflowStatus.Prepared
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Prepared" ;
    skos:notation "6"^^xsd:integer ;
    skos:definition "The workflow component has prepared the composition and can begin updating."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Prepared" ;
    hc:mayTransitionTo hc:WorkflowStatus.Updating, hc:WorkflowStatus.Finishing, hc:WorkflowStatus.Failed .

hc:WorkflowStatus.Updating
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Updating" ;
    skos:notation "7"^^xsd:integer ;
    skos:definition "The workflow component is performing an update step."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Updating" ;
    hc:mayTransitionTo hc:WorkflowStatus.Updated, hc:WorkflowStatus.Paused, hc:WorkflowStatus.Done, hc:WorkflowStatus.Failed .

hc:WorkflowStatus.Updated
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Updated" ;
    skos:notation "8"^^xsd:integer ;
    skos:definition "The workflow component has successfully updated."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Updated" ;
    hc:mayTransitionTo hc:WorkflowStatus.Updating, hc:WorkflowStatus.Finishing, hc:WorkflowStatus.Failed .

hc:WorkflowStatus.Paused
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Paused" ;
    skos:notation "9"^^xsd:integer ;
    skos:definition "The workflow component is paused at a synchronization point (see requestPause()) and can be resumed."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Paused" ;
    hc:mayTransitionTo hc:WorkflowStatus.Updated, hc:WorkflowStatus.Finishing, hc:WorkflowStatus.Failed .

hc:WorkflowStatus.Done
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Done" ;
    skos:notation "10"^^xsd:integer ;
    skos:definition "The workflow component has completed all update steps."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Done" ;
    hc:mayTransitionTo hc:WorkflowStatus.Finishing, hc:WorkflowStatus.Failed .

hc:WorkflowStatus.Finishing
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Finishing" ;
    skos:notation "11"^^xsd:integer ;
    skos:definition "The workflow component is finalizing and releasing resources."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Finishing" ;
    hc:mayTransitionTo hc:WorkflowStatus.Finished, hc:WorkflowStatus.Failed .

hc:WorkflowStatus.Finished
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Finished" ;
    skos:notation "12"^^xsd:integer ;
    skos:definition "The workflow component has finished and cannot be restarted."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Finished" .

hc:WorkflowStatus.Failed
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Failed" ;
    skos:notation "13"^^xsd:integer ;
    skos:definition "The workflow component encountered an unrecoverable error."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Failed" ;
    hc:mayTransitionTo hc:WorkflowStatus.Initializing, hc:WorkflowStatus.Finishing .

hc:WorkflowStatus.Invalid
    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Invalid" ;
    skos:notation "14"^^xsd:integer ;
    skos:definition "The workflow component found problems in the composition; fix the composition and validate() again."@en ;
    hc:cppName "HydroCouple::IWorkflowComponent::WorkflowStatus::Invalid" ;
    hc:mayTransitionTo hc:WorkflowStatus.Validating, hc:WorkflowStatus.Finishing, hc:WorkflowStatus.Failed .
