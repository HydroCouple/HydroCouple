    skos:hasTopConcept hc:ValueKind.Unknown, hc:ValueKind.Intensive, hc:ValueKind.Extensive, hc:ValueKind.Flux, hc:ValueKind.Density .

hc:ValueKind.Unknown
    a skos:Concept, hc:ValueKind ;
    skos:inScheme hc:ValueKind ;
    skos:topConceptOf hc:ValueKind ;
    skos:prefLabel "Unknown" ;
    skos:notation "0"^^xsd:integer ;
    skos:definition "Not declared. Adapters must not guess; they should refuse or ask."@en ;
    hc:cppName "HydroCouple::ValueKind::Unknown" .

hc:ValueKind.Intensive
    a skos:Concept, hc:ValueKind ;
    skos:inScheme hc:ValueKind ;
    skos:topConceptOf hc:ValueKind ;
    skos:prefLabel "Intensive" ;
    skos:notation "1"^^xsd:integer ;
    skos:definition "Independent of extent — temperature, concentration, elevation. Averages."@en ;
    hc:cppName "HydroCouple::ValueKind::Intensive" .

hc:ValueKind.Extensive
    a skos:Concept, hc:ValueKind ;
    skos:inScheme hc:ValueKind ;
    skos:topConceptOf hc:ValueKind ;
    skos:prefLabel "Extensive" ;
    skos:notation "2"^^xsd:integer ;
    skos:definition "Proportional to extent — mass, volume, heat content. Sums."@en ;
    hc:cppName "HydroCouple::ValueKind::Extensive" .

hc:ValueKind.Flux
