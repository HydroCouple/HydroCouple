    a skos:Concept, hc:VectorBasis ;
    skos:inScheme hc:VectorBasis ;
    skos:topConceptOf hc:VectorBasis ;
    skos:prefLabel "Unknown" ;
    skos:notation "0"^^xsd:integer ;
    skos:definition "Not declared. Consumers must not assume."@en ;
    hc:cppName "HydroCouple::Spatial::VectorBasis::Unknown" .

hc:VectorBasis.Cartesian
    a skos:Concept, hc:VectorBasis ;
    skos:inScheme hc:VectorBasis ;
    skos:topConceptOf hc:VectorBasis ;
    skos:prefLabel "Cartesian" ;
    skos:notation "1"^^xsd:integer ;
    skos:definition "Components along the reference system's x, y (and z) axes, in that order."@en ;
    hc:cppName "HydroCouple::Spatial::VectorBasis::Cartesian" .

hc:VectorBasis.EastNorthUp
    a skos:Concept, hc:VectorBasis ;
    skos:inScheme hc:VectorBasis ;
    skos:topConceptOf hc:VectorBasis ;
    skos:prefLabel "EastNorthUp" ;
    skos:notation "2"^^xsd:integer ;
    skos:definition "Components along local east, north (and up) for geographic reference systems."@en ;
    hc:cppName "HydroCouple::Spatial::VectorBasis::EastNorthUp" .

hc:VectorBasis.NormalTangential
    a skos:Concept, hc:VectorBasis ;
    skos:inScheme hc:VectorBasis ;
    skos:topConceptOf hc:VectorBasis ;
    skos:prefLabel "NormalTangential" ;
    skos:notation "3"^^xsd:integer ;
    skos:definition "For edge/face data: component 0 normal to the entity (positive from left face to right face as IMeshView::edgeFaces() orders them), component 1 tangential, component 2 (if any) vertical."@en ;
