    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "edgeCount" ;
    rdfs:comment "The number of edges in the mesh."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:long ;
    hc:cppName "HydroCouple::Spatial::IMeshView::edgeCount" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.edgeFaces
    a owl:DatatypeProperty ;
    rdfs:label "edgeFaces" ;
    rdfs:comment "The two faces of every edge: edge e separates edgeFaces()[2*e] (left, looking from edgeNodes()[2*e] toward edgeNodes()[2*e+1]) from edgeFaces()[2*e+1] (right); -1 marks the outside of the mesh, so a boundary edge has exactly one -1 [edge_face_connectivity]."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:long ;
    hc:cppName "HydroCouple::Spatial::IMeshView::edgeFaces" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.edgeLengths
    a owl:DatatypeProperty ;
    rdfs:label "edgeLengths" ;
    rdfs:comment "Length of every edge in the reference system's distance units; edgeCount() or empty."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:double ;
    hc:cppName "HydroCouple::Spatial::IMeshView::edgeLengths" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.edgeNodes
    a owl:DatatypeProperty ;
    rdfs:label "edgeNodes" ;
    rdfs:comment "Node index pairs of all edges: edge e connects edgeNodes()[2*e] and edgeNodes()[2*e + 1]."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:long ;
    hc:cppName "HydroCouple::Spatial::IMeshView::edgeNodes" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.edgeNormalX
    a owl:DatatypeProperty ;
    rdfs:label "edgeNormalX" ;
    rdfs:comment "x component of every edge's unit normal, pointing from the left face to the right face as edgeFaces() orders them; edgeCount() or empty."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:double ;
    hc:cppName "HydroCouple::Spatial::IMeshView::edgeNormalX" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.edgeNormalY
    a owl:DatatypeProperty ;
    rdfs:label "edgeNormalY" ;
    rdfs:comment "y component of every edge's unit normal; edgeCount() or empty."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:double ;
    hc:cppName "HydroCouple::Spatial::IMeshView::edgeNormalY" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.faceAreas
    a owl:DatatypeProperty ;
    rdfs:label "faceAreas" ;
    rdfs:comment "Plan area of every face in the reference system's distance units squared; faceCount() or empty."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:double ;
    hc:cppName "HydroCouple::Spatial::IMeshView::faceAreas" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.faceCount
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "faceCount" ;
    rdfs:comment "The number of faces (patches/cells) in the mesh; 0 for a pure network."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:long ;
    hc:cppName "HydroCouple::Spatial::IMeshView::faceCount" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.faceEdgeOffsets
    a owl:DatatypeProperty ;
    rdfs:label "faceEdgeOffsets" ;
    rdfs:comment "CSR row offsets into faceEdges(): the edges of face f are faceEdges()[faceEdgeOffsets()[f] ... faceEdgeOffsets()[f+1])."@en ;
