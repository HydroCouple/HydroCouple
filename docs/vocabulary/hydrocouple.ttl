hc:ValueKind
    a owl:Class, skos:ConceptScheme ;
    rdfs:label "ValueKind" ;
    rdfs:comment "How a value behaves when it is regridded or aggregated."@en ;
    hc:cppName "HydroCouple::ValueKind" ;
