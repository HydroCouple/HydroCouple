hc:TimeKind.IntervalMean
    a skos:Concept, hc:TimeKind ;
    skos:inScheme hc:TimeKind ;
    skos:topConceptOf hc:TimeKind ;
    skos:prefLabel "IntervalMean" ;
    skos:notation "2"^^xsd:integer ;
    skos:definition "Mean over the interval ending at the time coordinate."@en ;
