    rdfs:comment "x coordinate of every face's representative point (centroid or circumcentre, producer's choice) [face_x]; faceCount() or empty."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:double ;
    hc:cppName "HydroCouple::Spatial::IMeshView::faceX" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.faceY
    a owl:DatatypeProperty ;
    rdfs:label "faceY" ;
    rdfs:comment "y coordinate of every face's representative point [face_y]; faceCount() or empty."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:double ;
    hc:cppName "HydroCouple::Spatial::IMeshView::faceY" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.nodeCount
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "nodeCount" ;
    rdfs:comment "The number of nodes (vertices) in the mesh."@en ;
    rdfs:domain hc:IMeshView ;
    rdfs:range xsd:long ;
    hc:cppName "HydroCouple::Spatial::IMeshView::nodeCount" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView.nodeX
    a owl:DatatypeProperty ;
    rdfs:label "nodeX" ;
