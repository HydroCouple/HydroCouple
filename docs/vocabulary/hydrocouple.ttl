hc:CrossSectionKind.Analytic
    a skos:Concept, hc:CrossSectionKind ;
    skos:inScheme hc:CrossSectionKind ;
    skos:topConceptOf hc:CrossSectionKind ;
    skos:prefLabel "Analytic" ;
    skos:notation "3"^^xsd:integer ;
    skos:definition "A closed form: circular, trapezoidal, and the rest."@en ;
    hc:cppName "HydroCouple::Spatial::CrossSectionKind::Analytic" .

