@prefix hc: <https://hydrocouple.org/HydroCouple/vocabulary/#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://hydrocouple.org/HydroCouple/vocabulary/>
    a owl:Ontology ;
    dcterms:title "HydroCouple interface vocabulary"@en ;
    rdfs:comment "The concepts of the HydroCouple component interface standard — its interfaces, enumerations, accessors and lifecycle state machines — generated from the C++ headers, which remain the normative definition."@en ;
    owl:versionInfo "2.0.0-beta.1 (interface ABI 5)" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    rdfs:seeAlso <https://github.com/HydroCouple/HydroCouple> .

hc:cppName
    a owl:AnnotationProperty ;
    rdfs:label "cppName" ;
    rdfs:comment "The fully qualified C++ name the term is generated from."@en ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:canonicalDimensionOrdering
    a owl:AnnotationProperty ;
    rdfs:label "canonicalDimensionOrdering" ;
    rdfs:comment "The order of a data item's axes, as its C++ documentation states it."@en ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:mayTransitionTo
    a owl:ObjectProperty ;
    rdfs:label "mayTransitionTo" ;
    rdfs:comment "A legal lifecycle transition (normative: Helpers::isValidComponentStatusTransition() and isValidWorkflowStatusTransition())."@en ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:BufferDescriptor
    a owl:Class ;
    rdfs:label "BufferDescriptor" ;
    rdfs:comment "BufferDescriptor describes a typed, possibly strided, possibly device-resident multi-dimensional array. It is the sole currency of field data exchange."@en ;
    hc:cppName "HydroCouple::BufferDescriptor" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:DifferentialEntry
    a owl:Class ;
    rdfs:label "DifferentialEntry" ;
    rdfs:comment "DifferentialEntry pairs one data item, in one role, with a buffer holding its tangent (forward mode) or cotangent (reverse mode)."@en ;
    hc:cppName "HydroCouple::DifferentialEntry" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:Endpoint
    a owl:Class ;
    rdfs:label "Endpoint" ;
    rdfs:comment "Endpoint identifies one participant reachable through this transport."@en ;
    hc:cppName "HydroCouple::Distributed::ITransport::Endpoint" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ErrorEntry
    a owl:Class ;
    rdfs:label "ErrorEntry" ;
    rdfs:comment "ErrorEntry is one diagnostic record in a component's error queue."@en ;
    hc:cppName "HydroCouple::ErrorEntry" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IAdaptedOutput
    a owl:Class ;
    rdfs:label "IAdaptedOutput" ;
    rdfs:comment "An IAdaptedOutput adds one or more data operations on top of an IOutput."@en ;
    rdfs:subClassOf hc:IOutput ;
    hc:cppName "HydroCouple::IAdaptedOutput" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IAdaptedOutputFactory
    a owl:Class ;
    rdfs:label "IAdaptedOutputFactory" ;
    rdfs:comment "IAdaptedOutputFactory is used to create instances of IAdaptedOutput."@en ;
    rdfs:subClassOf hc:IIdentity ;
    hc:cppName "HydroCouple::IAdaptedOutputFactory" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IAdaptedOutputFactoryComponent
    a owl:Class ;
    rdfs:label "IAdaptedOutputFactoryComponent" ;
    rdfs:comment "IAdaptedOutputFactoryComponent is an IAdaptedOutputFactory generated from an IAdaptedOutputFactoryComponentInfo."@en ;
    rdfs:subClassOf hc:IAdaptedOutputFactory ;
    hc:cppName "HydroCouple::IAdaptedOutputFactoryComponent" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IAdaptedOutputFactoryComponentInfo
    a owl:Class ;
    rdfs:label "IAdaptedOutputFactoryComponentInfo" ;
    rdfs:comment "IAdaptedOutputFactoryComponentInfo interface class provides information about an IAdaptedOutputFactoryComponent."@en ;
    rdfs:subClassOf hc:IComponentInfo ;
    hc:cppName "HydroCouple::IAdaptedOutputFactoryComponentInfo" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IArgument
    a owl:Class ;
    rdfs:label "IArgument" ;
    rdfs:comment "IArgument interface class used to set the arguments for components. They can be complex or simple multi-dimensional datasets"@en ;
    rdfs:subClassOf hc:IComponentDataItem ;
    hc:cppName "HydroCouple::IArgument" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ICheckpointableAdaptedOutput
    a owl:Class ;
    rdfs:label "ICheckpointableAdaptedOutput" ;
    rdfs:comment "ICheckpointableAdaptedOutput is an adapted output that can save and restore the state it carries between refreshes."@en ;
    rdfs:subClassOf hc:IAdaptedOutput ;
    hc:cppName "HydroCouple::ICheckpointableAdaptedOutput" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ICheckpointableModelComponent
    a owl:Class ;
    rdfs:label "ICheckpointableModelComponent" ;
    rdfs:comment "ICheckpointableModelComponent is an IModelComponent that can save and restore its complete simulation state."@en ;
    rdfs:subClassOf hc:IModelComponent ;
    hc:cppName "HydroCouple::ICheckpointableModelComponent" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ICloneableModelComponent
    a owl:Class ;
    rdfs:label "ICloneableModelComponent" ;
    rdfs:comment "The ICloneableModelComponent class is an IModelComponent that supports deep cloning of itself and its configuration."@en ;
    rdfs:subClassOf hc:IModelComponent ;
    hc:cppName "HydroCouple::ICloneableModelComponent" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IComponentDataItem
    a owl:Class ;
    rdfs:label "IComponentDataItem" ;
    rdfs:comment "IComponentDataItem is a fundamental unit of data for a component."@en ;
    rdfs:subClassOf hc:IIdentity ;
    hc:cppName "HydroCouple::IComponentDataItem" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IComponentDataItemValueChanged
    a owl:Class ;
    rdfs:label "IComponentDataItemValueChanged" ;
    rdfs:comment "IComponentDataItemValueChanged interface class used to notify when the values of a IComponentDataItem change."@en ;
    hc:cppName "HydroCouple::IComponentDataItemValueChanged" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IComponentInfo
    a owl:Class ;
    rdfs:label "IComponentInfo" ;
    rdfs:comment "IComponentInfo interface class is a factory that provides detailed metadata about a component and creates new instances of a component."@en ;
    rdfs:subClassOf hc:IIdentity ;
    hc:cppName "HydroCouple::IComponentInfo" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IComponentStatusChangeEventArgs
    a owl:Class ;
    rdfs:label "IComponentStatusChangeEventArgs" ;
    rdfs:comment "The IComponentStatusChangeEventArgs contains the information that will be passed when the IModelComponent fires a signal."@en ;
    hc:cppName "HydroCouple::IComponentStatusChangeEventArgs" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ICrossSection
    a owl:Class ;
    rdfs:label "ICrossSection" ;
    rdfs:comment "The shape of a channel at one place, as a function of stage."@en ;
    hc:cppName "HydroCouple::Spatial::ICrossSection" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ICurve
    a owl:Class ;
    rdfs:label "ICurve" ;
    rdfs:comment "A Curve is a 1-dimensional geometric object usually stored as a sequence of IPoints, with the subtype of ICurve specifying the form of the interpolation between IPoints."@en ;
    rdfs:subClassOf hc:IGeometry ;
    hc:cppName "HydroCouple::Spatial::ICurve" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IDateTime
    a owl:Class ;
    rdfs:label "IDateTime" ;
    rdfs:comment "IDateTime interface based on a Julian day"@en ;
    rdfs:subClassOf hc:IPropertyChanged ;
    hc:cppName "HydroCouple::Temporal::IDateTime" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IDescription
    a owl:Class ;
    rdfs:label "IDescription" ;
    rdfs:comment "IDescription interface class provides descriptive information on a HydroCouple object."@en ;
    rdfs:subClassOf hc:IPropertyChanged ;
    hc:cppName "HydroCouple::IDescription" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IDifferentiableAdaptedOutput
    a owl:Class ;
    rdfs:label "IDifferentiableAdaptedOutput" ;
    rdfs:comment "IDifferentiableAdaptedOutput is an adapted output that can report the derivative of its most recent refresh()."@en ;
    rdfs:subClassOf hc:IAdaptedOutput ;
    hc:cppName "HydroCouple::IDifferentiableAdaptedOutput" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IDifferentiableModelComponent
    a owl:Class ;
    rdfs:label "IDifferentiableModelComponent" ;
    rdfs:comment "IDifferentiableModelComponent is a model component that can report the derivative of its most recent step."@en ;
    rdfs:subClassOf hc:IModelComponent ;
    hc:cppName "HydroCouple::IDifferentiableModelComponent" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IDimension
    a owl:Class ;
    rdfs:label "IDimension" ;
    rdfs:comment "IDimension provides the properties of one axis of a data item's index space."@en ;
    rdfs:subClassOf hc:IIdentity ;
    hc:cppName "HydroCouple::IDimension" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IDistributedModelComponent
    a owl:Class ;
    rdfs:label "IDistributedModelComponent" ;
    rdfs:comment "IDistributedModelComponent is an IModelComponent that participates in distributed execution through a transport."@en ;
    rdfs:subClassOf hc:IModelComponent ;
    hc:cppName "HydroCouple::Distributed::IDistributedModelComponent" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IEdge
    a owl:Class ;
    rdfs:label "IEdge" ;
    rdfs:comment "A directed edge from one vertex to another, adjacent to two faces. Based on Dani Lischinski's code from Graphics Gems IV. Original quad-edge data structure due to Guibas and Stolfi (1985). Does not inherit from geometry to reduce size. since each edge has 4 pointers."@en ;
    hc:cppName "HydroCouple::Spatial::IEdge" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IEnvelope
    a owl:Class ;
    rdfs:label "IEnvelope" ;
    rdfs:comment "IEnvelope represents the minimum bounding box of a geometry."@en ;
    hc:cppName "HydroCouple::Spatial::IEnvelope" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IExchangeItem
    a owl:Class ;
    rdfs:label "IExchangeItem" ;
    rdfs:comment "IExchangeItem the base data item the can be exchanged between components at runtime."@en ;
    rdfs:subClassOf hc:IComponentDataItem ;
    hc:cppName "HydroCouple::IExchangeItem" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IExchangeRequest
    a owl:Class ;
    rdfs:label "IExchangeRequest" ;
    rdfs:comment "IExchangeRequest is a handle to an asynchronous communication operation."@en ;
    hc:cppName "HydroCouple::Distributed::IExchangeRequest" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IGeometry
    a owl:Class ;
    rdfs:label "IGeometry" ;
    rdfs:comment "IGeometry is the root class of the geometry hierarchy."@en ;
    hc:cppName "HydroCouple::Spatial::IGeometry" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IGeometryCollection
    a owl:Class ;
    rdfs:label "IGeometryCollection" ;
    rdfs:comment "An IGeometryCollection is a geometric object that is a collection of some number of IGeometry objects."@en ;
    rdfs:subClassOf hc:IGeometry ;
    hc:cppName "HydroCouple::Spatial::IGeometryCollection" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IGeometryComponentDataItem
    a owl:Class ;
    rdfs:label "IGeometryComponentDataItem" ;
    rdfs:comment "IGeometryComponentDataItem is an IComponentDataItem whose data is associated with a collection of IGeometry objects. This class must be implemented as an abstract class."@en ;
    rdfs:subClassOf hc:IComponentDataItem ;
    hc:canonicalDimensionOrdering "the geometry dimension is dimension 0 of shape() (IDimension::DimensionRole::Entity); any additional dimensions follow."@en ;
    hc:cppName "HydroCouple::Spatial::IGeometryComponentDataItem" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IIdBasedComponentDataItem
    a owl:Class ;
    rdfs:label "IIdBasedComponentDataItem" ;
    rdfs:comment "IIdBasedComponentDataItem is an IComponentDataItem whose data is indexed by string identifiers."@en ;
    rdfs:subClassOf hc:IComponentDataItem ;
    hc:canonicalDimensionOrdering "the identifier dimension is dimension 0 of shape(); any additional dimensions follow."@en ;
    hc:cppName "HydroCouple::IIdBasedComponentDataItem" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IIdentity
    a owl:Class ;
    rdfs:label "IIdentity" ;
    rdfs:comment "IIdentity interface class defines a method to get the Id of an HydroCouple entity."@en ;
    rdfs:subClassOf hc:IDescription ;
    hc:cppName "HydroCouple::IIdentity" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IInput
    a owl:Class ;
    rdfs:label "IInput" ;
    rdfs:comment "An IInput item that can accept values for an IModelComponent."@en ;
    rdfs:subClassOf hc:IExchangeItem ;
    hc:cppName "HydroCouple::IInput" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ILayeredMeshComponentDataItem
    a owl:Class ;
    rdfs:label "ILayeredMeshComponentDataItem" ;
    rdfs:comment "A polyhedral surface whose values are resolved into vertical layers."@en ;
    rdfs:subClassOf hc:IPolyhedralSurfaceComponentDataItem, hc:ILayering ;
    hc:cppName "HydroCouple::Spatial::ILayeredMeshComponentDataItem" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ILayeredNetworkComponentDataItem
    a owl:Class ;
    rdfs:label "ILayeredNetworkComponentDataItem" ;
    rdfs:comment "A network carrying a vertical profile, and optionally a channel shape, at each node or edge."@en ;
    rdfs:subClassOf hc:INetworkComponentDataItem, hc:ILayering ;
    hc:cppName "HydroCouple::Spatial::ILayeredNetworkComponentDataItem" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ILayering
    a owl:Class ;
    rdfs:label "ILayering" ;
    rdfs:comment "Values resolved into vertical layers, whatever the plan geometry."@en ;
    hc:cppName "HydroCouple::Spatial::ILayering" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ILicensedComponent
    a owl:Class ;
    rdfs:label "ILicensedComponent" ;
    rdfs:comment "ILicensedComponent is an optional side interface for components that require license validation."@en ;
    hc:cppName "HydroCouple::ILicensedComponent" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ILine
    a owl:Class ;
    rdfs:label "ILine" ;
    rdfs:comment "The ILine class is an ILineString with exactly 2 IPoints."@en ;
    rdfs:subClassOf hc:ILineString ;
    hc:cppName "HydroCouple::Spatial::ILine" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ILineString
    a owl:Class ;
    rdfs:label "ILineString" ;
    rdfs:comment "An ILineString is a Curve with linear interpolation between Points. Each consecutive pair of Points defines a Line segment."@en ;
    rdfs:subClassOf hc:ICurve ;
    hc:cppName "HydroCouple::Spatial::ILineString" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:ILinearRing
    a owl:Class ;
    rdfs:label "ILinearRing" ;
    rdfs:comment "An ILinearRing is an ILineString that is both isClosed() and isSimple()."@en ;
    rdfs:subClassOf hc:ILineString ;
    hc:cppName "HydroCouple::Spatial::ILinearRing" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMeshView
    a owl:Class ;
    rdfs:label "IMeshView" ;
    rdfs:comment "IMeshView is a bulk, structure-of-arrays view of an unstructured mesh or network: flat coordinate spans plus CSR (compressed sparse row) connectivity."@en ;
    hc:cppName "HydroCouple::Spatial::IMeshView" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IModelComponent
    a owl:Class ;
    rdfs:label "IModelComponent" ;
    rdfs:comment "IModelComponent interface is the core interface in the HydroCouple standard defining a model component."@en ;
    rdfs:subClassOf hc:IIdentity ;
    hc:cppName "HydroCouple::IModelComponent" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IModelComponentInfo
    a owl:Class ;
    rdfs:label "IModelComponentInfo" ;
    rdfs:comment "IModelComponentInfo interface inherits from the IComponentInfo interface which provides detailed metadata about an IModelComponent. Additionally, it creates new instances of a component."@en ;
    rdfs:subClassOf hc:IComponentInfo ;
    hc:cppName "HydroCouple::IModelComponentInfo" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMultiCurve
    a owl:Class ;
    rdfs:label "IMultiCurve" ;
    rdfs:comment "An IMultiCurve is a 1-dimensional IGeometryCollection whose elements are ICurves."@en ;
    rdfs:subClassOf hc:IGeometryCollection ;
    hc:cppName "HydroCouple::Spatial::IMultiCurve" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMultiInput
    a owl:Class ;
    rdfs:label "IMultiInput" ;
    rdfs:comment "The IMultiInput class is an IInput class that has multiple outputs supplying data to it."@en ;
    rdfs:subClassOf hc:IInput ;
    hc:cppName "HydroCouple::IMultiInput" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMultiLineString
    a owl:Class ;
    rdfs:label "IMultiLineString" ;
    rdfs:comment "An IMultiLineString is an IMultiCurve whose elements are ILineStrings."@en ;
    rdfs:subClassOf hc:IMultiCurve ;
    hc:cppName "HydroCouple::Spatial::IMultiLineString" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMultiPoint
    a owl:Class ;
    rdfs:label "IMultiPoint" ;
    rdfs:comment "An IMultiPoint is a 0-dimensional IGeometryCollection."@en ;
    rdfs:subClassOf hc:IGeometryCollection ;
    hc:cppName "HydroCouple::Spatial::IMultiPoint" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMultiPolygon
    a owl:Class ;
    rdfs:label "IMultiPolygon" ;
    rdfs:comment "An IMultiPolygon is an IMultiSurface whose elements are IPolygons."@en ;
    rdfs:subClassOf hc:IMultiSurface ;
    hc:cppName "HydroCouple::Spatial::IMultiPolygon" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IMultiSurface
    a owl:Class ;
    rdfs:label "IMultiSurface" ;
    rdfs:comment "A MultiSurface is a 2-dimensional GeometryCollection whose elements are Surfaces, all using coordinates from the same coordinate reference system."@en ;
    rdfs:subClassOf hc:IGeometryCollection ;
    hc:cppName "HydroCouple::Spatial::IMultiSurface" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:INetwork
    a owl:Class ;
    rdfs:label "INetwork" ;
    rdfs:comment "INetwork represents a graph structure of connected vertices and edges."@en ;
    rdfs:subClassOf hc:IIdentity ;
    hc:cppName "HydroCouple::Spatial::INetwork" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:INetworkComponentDataItem
    a owl:Class ;
    rdfs:label "INetworkComponentDataItem" ;
    rdfs:comment "INetworkComponentDataItem is an IComponentDataItem whose data is associated with the edges or the nodes of an INetwork."@en ;
    rdfs:subClassOf hc:IComponentDataItem ;
    hc:canonicalDimensionOrdering "the entity dimension selected by location() (Node or Edge; DimensionRole::Entity) is dimension 0 of shape(); a Component dimension follows when networkDataType() is not Scalar; any additional dimensions follow that."@en ;
    hc:cppName "HydroCouple::Spatial::INetworkComponentDataItem" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IOutput
    a owl:Class ;
    rdfs:label "IOutput" ;
    rdfs:comment "An output exchange item that can deliver values from an IModelComponent."@en ;
    rdfs:subClassOf hc:IExchangeItem ;
    hc:cppName "HydroCouple::IOutput" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IPartitionedComponentDataItem
    a owl:Class ;
    rdfs:label "IPartitionedComponentDataItem" ;
    rdfs:comment "IPartitionedComponentDataItem is an IComponentDataItem whose entity dimension is decomposed across partitions, with local virtual (ghost/halo) representation of remotely owned entities."@en ;
    rdfs:subClassOf hc:IComponentDataItem ;
    hc:cppName "HydroCouple::Distributed::IPartitionedComponentDataItem" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IPoint
    a owl:Class ;
    rdfs:label "IPoint" ;
    rdfs:comment "An IPoint is a 0-dimensional geometric object and represents a single location in coordinate space."@en ;
    rdfs:subClassOf hc:IGeometry ;
    hc:cppName "HydroCouple::Spatial::IPoint" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IPolygon
    a owl:Class ;
    rdfs:label "IPolygon" ;
    rdfs:comment "A IPolygon is a planar ISurface defined by 1 exterior boundary and 0 or more interior boundaries."@en ;
    rdfs:subClassOf hc:ISurface ;
    hc:cppName "HydroCouple::Spatial::IPolygon" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IPolyhedralSurface
    a owl:Class ;
    rdfs:label "IPolyhedralSurface" ;
    rdfs:comment "An IPolyhedralSurface is a contiguous collection of polygon patches or facets stitched together along their shared boundary edges."@en ;
    rdfs:subClassOf hc:ISurface ;
    hc:cppName "HydroCouple::Spatial::IPolyhedralSurface" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IPolyhedralSurfaceComponentDataItem
    a owl:Class ;
    rdfs:label "IPolyhedralSurfaceComponentDataItem" ;
    rdfs:comment "IPolyhedralSurfaceComponentDataItem is an IComponentDataItem whose data is associated with the faces (patches), edges, or nodes of an IPolyhedralSurface."@en ;
    rdfs:subClassOf hc:IComponentDataItem ;
    hc:canonicalDimensionOrdering "the entity dimension selected by location() (DimensionRole::Entity) is dimension 0 of shape(); a Component dimension follows when meshDataType() is not Scalar; any additional dimensions follow that."@en ;
    hc:cppName "HydroCouple::Spatial::IPolyhedralSurfaceComponentDataItem" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> .

hc:IPropertyChanged
