    a skos:Concept, hc:WorkflowStatus ;
    skos:inScheme hc:WorkflowStatus ;
    skos:topConceptOf hc:WorkflowStatus ;
    skos:prefLabel "Created" ;
    skos:notation "0"^^xsd:integer ;
    skos:definition "The workflow component has just been created."@en ;
