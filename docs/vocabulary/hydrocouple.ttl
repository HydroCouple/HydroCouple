hc:SpatialDataType
    a owl:Class, skos:ConceptScheme ;
    rdfs:label "SpatialDataType" ;
    rdfs:comment "The algebraic structure of the value at each entity: a scalar, a set of independent scalars, a vector or a tensor."@en ;
    hc:cppName "HydroCouple::Spatial::SpatialDataType" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> ;
    skos:hasTopConcept hc:SpatialDataType.Scalar, hc:SpatialDataType.MultiScalar, hc:SpatialDataType.Vector, hc:SpatialDataType.Tensor .

hc:SpatialDataType.Scalar
    a skos:Concept, hc:SpatialDataType ;
    skos:inScheme hc:SpatialDataType ;
    skos:topConceptOf hc:SpatialDataType ;
    skos:prefLabel "Scalar" ;
    skos:notation "0"^^xsd:integer ;
    skos:definition "One value per entity; no component dimension."@en ;
    hc:cppName "HydroCouple::Spatial::SpatialDataType::Scalar" .

hc:SpatialDataType.MultiScalar
    a skos:Concept, hc:SpatialDataType ;
    skos:inScheme hc:SpatialDataType ;
    skos:topConceptOf hc:SpatialDataType ;
    skos:prefLabel "MultiScalar" ;
    skos:notation "1"^^xsd:integer ;
    skos:definition "Several independent scalars per entity (e.g. constituents); component dimension of that count, basis irrelevant."@en ;
    hc:cppName "HydroCouple::Spatial::SpatialDataType::MultiScalar" .

hc:SpatialDataType.Vector
    a skos:Concept, hc:SpatialDataType ;
    skos:inScheme hc:SpatialDataType ;
    skos:topConceptOf hc:SpatialDataType ;
    skos:prefLabel "Vector" ;
    skos:notation "2"^^xsd:integer ;
    skos:definition "A vector per entity; component dimension of length 2 or 3 in the order vectorBasis() defines."@en ;
    hc:cppName "HydroCouple::Spatial::SpatialDataType::Vector" .

hc:SpatialDataType.Tensor
    a skos:Concept, hc:SpatialDataType ;
    skos:inScheme hc:SpatialDataType ;
    skos:topConceptOf hc:SpatialDataType ;
    skos:prefLabel "Tensor" ;
    skos:notation "3"^^xsd:integer ;
    skos:definition "A rank-2 tensor per entity; component dimension holding the row-major flattening (4 or 9 entries) in the basis vectorBasis() defines."@en ;
    hc:cppName "HydroCouple::Spatial::SpatialDataType::Tensor" .

hc:TimeExtrapolation
    a owl:Class, skos:ConceptScheme ;
    rdfs:label "TimeExtrapolation" ;
    rdfs:comment "How a provider produces a value at an instant beyond the last (or before the first) it holds."@en ;
    hc:cppName "HydroCouple::Temporal::TimeExtrapolation" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> ;
    skos:hasTopConcept hc:TimeExtrapolation.Unknown, hc:TimeExtrapolation.Refuse, hc:TimeExtrapolation.HoldLast, hc:TimeExtrapolation.Linear .

hc:TimeExtrapolation.Unknown
    a skos:Concept, hc:TimeExtrapolation ;
    skos:inScheme hc:TimeExtrapolation ;
    skos:topConceptOf hc:TimeExtrapolation ;
    skos:prefLabel "Unknown" ;
    skos:notation "0"^^xsd:integer ;
    skos:definition "Not declared. validate() must treat a connection whose two ends both say Unknown as an error."@en ;
    hc:cppName "HydroCouple::Temporal::TimeExtrapolation::Unknown" .

hc:TimeExtrapolation.Refuse
    a skos:Concept, hc:TimeExtrapolation ;
    skos:inScheme hc:TimeExtrapolation ;
    skos:topConceptOf hc:TimeExtrapolation ;
    skos:prefLabel "Refuse" ;
    skos:notation "1"^^xsd:integer ;
    skos:definition "A query outside the held range is refused; the provider must be advanced first."@en ;
    hc:cppName "HydroCouple::Temporal::TimeExtrapolation::Refuse" .

hc:TimeExtrapolation.HoldLast
    a skos:Concept, hc:TimeExtrapolation ;
    skos:inScheme hc:TimeExtrapolation ;
    skos:topConceptOf hc:TimeExtrapolation ;
    skos:prefLabel "HoldLast" ;
    skos:notation "2"^^xsd:integer ;
    skos:definition "Repeat the boundary value."@en ;
    hc:cppName "HydroCouple::Temporal::TimeExtrapolation::HoldLast" .

hc:TimeExtrapolation.Linear
    a skos:Concept, hc:TimeExtrapolation ;
    skos:inScheme hc:TimeExtrapolation ;
    skos:topConceptOf hc:TimeExtrapolation ;
    skos:prefLabel "Linear" ;
    skos:notation "3"^^xsd:integer ;
    skos:definition "Extend the last two values linearly."@en ;
    hc:cppName "HydroCouple::Temporal::TimeExtrapolation::Linear" .

hc:TimeInterpolation
    a owl:Class, skos:ConceptScheme ;
    rdfs:label "TimeInterpolation" ;
    rdfs:comment "How a provider produces a value at an instant that is between two it holds."@en ;
    hc:cppName "HydroCouple::Temporal::TimeInterpolation" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> ;
    skos:hasTopConcept hc:TimeInterpolation.Unknown, hc:TimeInterpolation.None, hc:TimeInterpolation.Previous, hc:TimeInterpolation.Nearest, hc:TimeInterpolation.Linear .

hc:TimeInterpolation.Unknown
    a skos:Concept, hc:TimeInterpolation ;
    skos:inScheme hc:TimeInterpolation ;
    skos:topConceptOf hc:TimeInterpolation ;
    skos:prefLabel "Unknown" ;
    skos:notation "0"^^xsd:integer ;
    skos:definition "Not declared. validate() must treat a connection whose two ends both say Unknown as an error."@en ;
    hc:cppName "HydroCouple::Temporal::TimeInterpolation::Unknown" .

hc:TimeInterpolation.None
    a skos:Concept, hc:TimeInterpolation ;
    skos:inScheme hc:TimeInterpolation ;
    skos:topConceptOf hc:TimeInterpolation ;
    skos:prefLabel "None" ;
    skos:notation "1"^^xsd:integer ;
    skos:definition "Exact match required (within TIME_EQUALITY_TOLERANCE_DAYS); a query at an instant not held is refused."@en ;
    hc:cppName "HydroCouple::Temporal::TimeInterpolation::None" .

hc:TimeInterpolation.Previous
    a skos:Concept, hc:TimeInterpolation ;
    skos:inScheme hc:TimeInterpolation ;
    skos:topConceptOf hc:TimeInterpolation ;
    skos:prefLabel "Previous" ;
    skos:notation "2"^^xsd:integer ;
    skos:definition "Hold the most recent earlier value (step function)."@en ;
    hc:cppName "HydroCouple::Temporal::TimeInterpolation::Previous" .

hc:TimeInterpolation.Nearest
    a skos:Concept, hc:TimeInterpolation ;
    skos:inScheme hc:TimeInterpolation ;
    skos:topConceptOf hc:TimeInterpolation ;
    skos:prefLabel "Nearest" ;
    skos:notation "3"^^xsd:integer ;
    skos:definition "The nearer of the two neighbours."@en ;
    hc:cppName "HydroCouple::Temporal::TimeInterpolation::Nearest" .

hc:TimeInterpolation.Linear
    a skos:Concept, hc:TimeInterpolation ;
    skos:inScheme hc:TimeInterpolation ;
    skos:topConceptOf hc:TimeInterpolation ;
    skos:prefLabel "Linear" ;
    skos:notation "4"^^xsd:integer ;
    skos:definition "Linear in time between neighbours."@en ;
    hc:cppName "HydroCouple::Temporal::TimeInterpolation::Linear" .

