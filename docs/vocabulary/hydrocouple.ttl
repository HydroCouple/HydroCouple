    hc:cppName "HydroCouple::Spatial::VectorBasis" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> ;
    skos:hasTopConcept hc:VectorBasis.Unknown, hc:VectorBasis.Cartesian, hc:VectorBasis.EastNorthUp, hc:VectorBasis.NormalTangential, hc:VectorBasis.AlongEntity .

