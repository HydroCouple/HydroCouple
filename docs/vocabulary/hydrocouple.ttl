hc:ComponentStatus
    a owl:Class, skos:ConceptScheme ;
    rdfs:label "ComponentStatus" ;
    rdfs:comment "HydroCouple::ComponentStatus is an enumerator that describes the status of a component over the course of its lifetime."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus" ;
    rdfs:isDefinedBy <https://hydrocouple.org/HydroCouple/vocabulary/> ;
    skos:hasTopConcept hc:ComponentStatus.Created, hc:ComponentStatus.Initializing, hc:ComponentStatus.Initialized, hc:ComponentStatus.Validating, hc:ComponentStatus.Valid, hc:ComponentStatus.WaitingForData, hc:ComponentStatus.Invalid, hc:ComponentStatus.Preparing, hc:ComponentStatus.Updating, hc:ComponentStatus.Updated, hc:ComponentStatus.Checkpointing, hc:ComponentStatus.Done, hc:ComponentStatus.Finishing, hc:ComponentStatus.Finished, hc:ComponentStatus.Failed .

hc:ComponentStatus.Created
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Created" ;
    skos:notation "0"^^xsd:integer ;
    skos:definition "The IModelComponent instance has just been created. This status must and will be followed by HydroCouple::Initializing."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Created" ;
    hc:mayTransitionTo hc:ComponentStatus.Initializing, hc:ComponentStatus.Failed .

hc:ComponentStatus.Initializing
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Initializing" ;
    skos:notation "1"^^xsd:integer ;
    skos:definition "The IModelComponent is initializing itself. This status will end in a status change to HydroCouple::Initialized or HydroCouple::Failed."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Initializing" ;
    hc:mayTransitionTo hc:ComponentStatus.Initialized, hc:ComponentStatus.Failed .

hc:ComponentStatus.Initialized
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Initialized" ;
    skos:notation "2"^^xsd:integer ;
    skos:definition "The IModelComponent has successfully initialized itself by calling IModelComponent::initialize(). The connections between its inputs/outputs and those of other components can be established."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Initialized" ;
    hc:mayTransitionTo hc:ComponentStatus.Initializing, hc:ComponentStatus.Validating, hc:ComponentStatus.Finishing, hc:ComponentStatus.Failed .

hc:ComponentStatus.Validating
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Validating" ;
    skos:notation "3"^^xsd:integer ;
    skos:definition "After links between an IModelComponent's inputs/outputs and those of other components have been established, the IModelComponent is HydroCouple::Validating whether its required input will be available when it updates itself, and whether indeed it will be able to provide the required output during this update. This Validating status will when the IModelComponent::status() changes to HydroCouple::Valid or HydroCouple::Invalid."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Validating" ;
    hc:mayTransitionTo hc:ComponentStatus.Valid, hc:ComponentStatus.Invalid, hc:ComponentStatus.Failed .

hc:ComponentStatus.Valid
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Valid" ;
    skos:notation "4"^^xsd:integer ;
    skos:definition "The IModelComponent is in a HydroCouple::Valid state. When updating itself its required input will be available, and it will be able to provide the required output."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Valid" ;
    hc:mayTransitionTo hc:ComponentStatus.Validating, hc:ComponentStatus.Preparing, hc:ComponentStatus.Finishing, hc:ComponentStatus.Failed .

hc:ComponentStatus.WaitingForData
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "WaitingForData" ;
    skos:notation "5"^^xsd:integer ;
    skos:definition "The IModelComponent wants to update itself, but is not yet able to perform the actual computation, because it is still waiting for input data from other components."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::WaitingForData" ;
    hc:mayTransitionTo hc:ComponentStatus.Updating, hc:ComponentStatus.Failed .

hc:ComponentStatus.Invalid
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Invalid" ;
    skos:notation "6"^^xsd:integer ;
    skos:definition "The IModelComponent is in an HydroCouple::Invalid state. When updating itself not all required input will be available, and/or it will not be able to provide the required output. After the user has modified the connections between the IModelComponent's inputs/outputs and those of other components, the HydroCouple::Validating state can be entered again"@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Invalid" ;
    hc:mayTransitionTo hc:ComponentStatus.Validating, hc:ComponentStatus.Finishing, hc:ComponentStatus.Failed .

hc:ComponentStatus.Preparing
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Preparing" ;
    skos:notation "7"^^xsd:integer ;
    skos:definition "The IModelComponent is preparing itself for the first update() and the first IComponentDataItem::getValuesInto() call. This HydroCouple::Preparing state will end in a status change to HydroCouple::Updated or HydroCouple::Failed."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Preparing" ;
    hc:mayTransitionTo hc:ComponentStatus.Updated, hc:ComponentStatus.Failed .

hc:ComponentStatus.Updating
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Updating" ;
    skos:notation "8"^^xsd:integer ;
    skos:definition "The IModelComponent is updating itself. It has received all required input data from other components, and is now performing the actual computation. This HydroCouple::Updating state will end in a status change to HydroCouple::Updated, HydroCouple::Done or HydroCouple::Failed."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Updating" ;
    hc:mayTransitionTo hc:ComponentStatus.WaitingForData, hc:ComponentStatus.Updated, hc:ComponentStatus.Done, hc:ComponentStatus.Failed .

hc:ComponentStatus.Updated
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Updated" ;
    skos:notation "9"^^xsd:integer ;
    skos:definition "The IModelComponent has successfully updated itself."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Updated" ;
    hc:mayTransitionTo hc:ComponentStatus.Updating, hc:ComponentStatus.Checkpointing, hc:ComponentStatus.Finishing, hc:ComponentStatus.Failed .

hc:ComponentStatus.Checkpointing
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Checkpointing" ;
    skos:notation "10"^^xsd:integer ;
    skos:definition "The IModelComponent is saving or restoring a checkpoint of its state (see ICheckpointableModelComponent). A save returns to the status it was entered from (HydroCouple::Updated or HydroCouple::Done); a successful restore always lands in HydroCouple::Updated; a failure lands in HydroCouple::Failed."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Checkpointing" ;
    hc:mayTransitionTo hc:ComponentStatus.Updated, hc:ComponentStatus.Done, hc:ComponentStatus.Failed .

hc:ComponentStatus.Done
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Done" ;
    skos:notation "11"^^xsd:integer ;
    skos:definition "The last update process that the IModelComponent performed was the final one. A next call to the IModelComponent::update() method will leave the IModelComponent's internal state unchanged."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Done" ;
    hc:mayTransitionTo hc:ComponentStatus.Checkpointing, hc:ComponentStatus.Finishing, hc:ComponentStatus.Failed .

hc:ComponentStatus.Finishing
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Finishing" ;
    skos:notation "12"^^xsd:integer ;
    skos:definition "The IModelComponent was requested to perform the actions to be performed before it will either be disposed or re-initialized again.Typical actions would be writing the final result files, close all open files, free memory, etc. When all required actions have been performed, the status switches to HydroCouple::Created when re-initialization is possible. The status switches to HydroCouple::Finished when the IModelComponent is to be disposed"@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Finishing" ;
    hc:mayTransitionTo hc:ComponentStatus.Created, hc:ComponentStatus.Finished, hc:ComponentStatus.Failed .

hc:ComponentStatus.Finished
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Finished" ;
    skos:notation "13"^^xsd:integer ;
    skos:definition "The IModelComponent has successfully performed its finalization actions. Re-initialization of the IModelComponent instance is not possible and should not be attempted. Instead the instance should be destroyed by its owner, after its connections are dismantled (see the lifetime convention)."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Finished" .

hc:ComponentStatus.Failed
    a skos:Concept, hc:ComponentStatus ;
    skos:inScheme hc:ComponentStatus ;
    skos:topConceptOf hc:ComponentStatus ;
    skos:prefLabel "Failed" ;
    skos:notation "14"^^xsd:integer ;
    skos:definition "The IModelComponent has encountered an unrecoverable error. Reachable from every status except Finished: a failure can be detected while the component rests (a proxy whose peer dies while it is Updated). Diagnostics describing the failure must be available from IModelComponent::errors(). From this state the component may be re-initialized by calling initialize() if it supports re-initialization, or finished and disposed via finish()."@en ;
    hc:cppName "HydroCouple::IModelComponent::ComponentStatus::Failed" ;
    hc:mayTransitionTo hc:ComponentStatus.Initializing, hc:ComponentStatus.Finishing .

